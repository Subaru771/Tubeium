{
  "name": "tubeium",
  "productName": "Tubeium",
  "version": "4.5.10",
  "description": "Native Windows YouTube client with local playlists, viewing profiles, audio presets, privacy-safe backups and more.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/test-settings.js && node tests/test-settings-taxonomy.js && node tests/test-download-queue.js && node tests/test-migration.js && node tests/test-signin.js && node tests/test-browser-session-transfer.js && node tests/test-simple-signin.js && node tests/test-restart-on-import.js && node tests/test-local-library.js && node tests/test-competitive-upgrade.js && node tests/test-privacy-and-branding.js && node tests/test-v4-3.js && node tests/test-v4-5.js && node tests/test-release-hardening.js && node tests/test-release-build-gates.js && node tests/test-signin-recovery.js && node tests/test-signin-choice.js && node tests/test-welcome-tab.js && node tests/test-default-browser-resolver.js && node tests/test-default-browser-navigation.js && node tests/test-brave-persistent-tabs.js && node tests/test-brave-behavior.js && node tests/test-clean-signin-browser.js && node tests/test-ad-transition.js && node tests/test-builder-version-detection.js",
    "build:windows": "electron-builder --win nsis portable --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "release:windows": "electron-builder --win nsis --x64 --publish always",
    "audit:release": "node scripts/audit-release.js",
    "verify:release": "npm run verify:dependencies && npm test && npm run audit:release",
    "verify:dependencies": "node scripts/check-dependency-lock.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:release-gates": "node tests/test-release-build-gates.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "io.tubeium.desktop",
    "productName": "Tubeium",
    "files": [
      "main.js",
      "signin-failure.js",
      "download-queue.js",
      "downloads-preload.js",
      "downloads.html",
      "downloads.css",
      "downloads-renderer.js",
      "preload.js",
      "settings-schema.js",
      "settings-preload.js",
      "settings.html",
      "settings.css",
      "settings-renderer.js",
      "assets/**",
      "migration-userdata.js",
      "signin-cookies.js",
      "browser-session-transfer.js",
      "default-browser.js",
      "clean-signin-browser.js",
      "browser-login-once/**",
      "library-store.js",
      "library.html",
      "library.css",
      "library-preload.js",
      "library-renderer.js",
      "dearrow.js",
      "permission-policy.js",
      "offline-player.html",
      "offline-player.css",
      "offline-player.js",
      "offline-preload.js",
      "offline-media.js",
      "downloader-integrity.js",
      "system-health.js",
      "gamepad-controls.js",
      "local-playlists.js",
      "backup-manager.js",
      "viewing-profiles.js",
      "audio-presets.js",
      "PRIVACY.md",
      "SECURITY.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README_RELEASE.md",
      "welcome.html",
      "welcome.css",
      "welcome-renderer.js",
      "welcome-preload.js",
      "tab-strip.html",
      "tab-strip.css",
      "tab-strip.js",
      "tab-strip-preload.js"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "browser-login-once/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Tubeium-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Tubeium-${version}-Portable-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "electron-updater": "6.8.12"
  }
}
