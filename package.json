{
  "name": "tubeium",
  "productName": "Tubeium",
  "version": "1.0.4",
  "description": "Native Windows YouTube client with local playlists, viewing profiles, audio presets, privacy-safe backups and more.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/run-all.js",
    "build:windows": "electron-builder --win nsis portable --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "release:windows": "electron-builder --win nsis --x64 --publish always",
    "audit:release": "node scripts/audit-release.js",
    "verify:release": "npm run verify:dependencies && npm test && npm run audit:release",
    "verify:dependencies": "node scripts/check-dependency-lock.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:release-gates": "node tests/test-release-build-gates.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "io.tubeium.desktop",
    "productName": "Tubeium",
    "files": [
      "src/main.js",
      "src/signin-failure.js",
      "src/download-queue.js",
      "src/downloads-preload.js",
      "src/downloads.html",
      "src/downloads.css",
      "src/downloads-renderer.js",
      "src/preload.js",
      "src/guide-toggle.js",
      "src/settings-schema.js",
      "src/settings-preload.js",
      "src/settings.html",
      "src/settings.css",
      "src/settings-renderer.js",
      "assets/**",
      "src/migration-userdata.js",
      "src/signin-cookies.js",
      "src/browser-session-transfer.js",
      "src/default-browser.js",
      "src/clean-signin-browser.js",
      "src/browser-login-once/**",
      "src/library-store.js",
      "src/library.html",
      "src/library.css",
      "src/library-preload.js",
      "src/library-renderer.js",
      "src/dearrow.js",
      "src/permission-policy.js",
      "src/offline-player.html",
      "src/offline-player.css",
      "src/offline-player.js",
      "src/offline-preload.js",
      "src/offline-media.js",
      "src/downloader-integrity.js",
      "src/ytdlp-installer.js",
      "src/ytdlp-pin.js",
      "src/system-health.js",
      "src/gamepad-controls.js",
      "src/local-playlists.js",
      "src/backup-manager.js",
      "src/viewing-profiles.js",
      "src/audio-presets.js",
      "PRIVACY.md",
      "SECURITY.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "src/welcome.html",
      "src/welcome.css",
      "src/welcome-renderer.js",
      "src/welcome-preload.js",
      "src/tab-strip.html",
      "src/tab-strip.css",
      "src/tab-strip.js",
      "src/tab-strip-preload.js"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "src/browser-login-once/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Tubeium-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Tubeium-${version}-Portable-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "electron-updater": "6.8.12"
  }
}
